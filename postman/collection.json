{
    "info": {
        "name": "Smart Home API",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            { "key": "token", "value": "{{accessToken}}", "type": "string" }
        ]
    },
    "item": [
        {
            "name": "Register user",
            "request": {
                "method": "POST",
                "auth": { "type": "noauth" },
                "header": [
                    { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\"email\":\"{{email}}\",\"password\":\"Passw0rd123\",\"name\":\"Власник\"}"
                },
                "url": "{{baseUrl}}/users"
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\"Статус 201\", () => { pm.response.to.have.status(201); });",
                            "pm.environment.set(\"userId\", pm.response.json().id);"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Log in",
            "request": {
                "method": "POST",
                "auth": { "type": "noauth" },
                "header": [
                    { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\"email\":\"{{email}}\",\"password\":\"Passw0rd123\"}"
                },
                "url": "{{baseUrl}}/login"
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\"Статус 200\", () => { pm.response.to.have.status(200); });",
                            "pm.test(\"Тип токена Bearer\", () => { pm.expect(pm.response.json().tokenType).to.eql(\"Bearer\"); });",
                            "pm.environment.set(\"accessToken\", pm.response.json().accessToken);"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Register a new device",
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "X-User-Id", "value": "{{userId}}" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\"name\":\"Лампа у вітальні\",\"type\":\"LAMP\"}"
                },
                "url": "{{baseUrl}}/devices"
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\"Статус 201\", () => { pm.response.to.have.status(201); });",
                            "pm.test(\"Тип LAMP\", () => { pm.expect(pm.response.json().type).to.eql(\"LAMP\"); });",
                            "pm.environment.set(\"deviceId\", pm.response.json().id);"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Create a command",
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\"name\":\"turn_on\",\"argsSchema\":\"{\\\"type\\\":\\\"object\\\",\\\"additionalProperties\\\":false}\",\"requiredRole\":\"GUEST\"}"
                },
                "url": "{{baseUrl}}/devices/{{deviceId}}/commands"
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\"Статус 201\", () => { pm.response.to.have.status(201); });",
                            "pm.environment.set(\"commandId\", pm.response.json().id);"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Execute the command",
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "X-User-Id", "value": "{{userId}}" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\"args\":{}}"
                },
                "url": "{{baseUrl}}/devices/{{deviceId}}/commands/{{commandId}}/executions"
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\"Статус 202\", () => { pm.response.to.have.status(202); });",
                            "pm.test(\"Статус виконання SUCCESS\", () => { pm.expect(pm.response.json().status).to.eql(\"SUCCESS\"); });",
                            "pm.environment.set(\"executionId\", pm.response.json().id);"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Get the execution journal",
            "request": {
                "method": "GET",
                "url": "{{baseUrl}}/devices/{{deviceId}}/executions"
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\"Статус 200\", () => { pm.response.to.have.status(200); });",
                            "pm.test(\"Журнал містить виконання\", () => { pm.expect(pm.response.json().map(e => e.id)).to.include(pm.environment.get(\"executionId\")); });"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Delete user",
            "request": {
                "method": "DELETE",
                "url": "{{baseUrl}}/users/{{userId}}"
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\"Статус 204\", () => { pm.response.to.have.status(204); });"
                        ]
                    }
                }
            ]
        }
    ]
}
